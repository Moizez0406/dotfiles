layout {

    focus-ring {
        active-color   "#7d5700"
        inactive-color "#fff8f3"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#7d5700"
        inactive-color "#fff8f3"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#7d5700"
        inactive-color "#ffdea9"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#7d570080"
    }
}

recent-windows {
    highlight {
        active-color "#7d5700"
        urgent-color "#ba1a1a"
    }
}
